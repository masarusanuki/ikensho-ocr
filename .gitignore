# 依存・ビルド成果物
.venv/
__pycache__/
*.pyc
node_modules/
# ビルド成果物（tools/build_web.py, tools/build_standalone.py で生成）
dist/
*.egg-info/

# 医療機関一覧（大容量。tools/fetch_hospitals.py で厚労省から取得する）
dict/hospitals/*.json
!dict/hospitals/index.json

# LLMモデル（大容量。tools/fetch_llm_model.py で取得する）
models/
*.gguf

# 個人情報を含みうるデータは絶対にコミットしない
master/
sample/
seigo/
data/
uploads/
out/
*.pdf
!docs/**/*.pdf

# 正解データから作る中間ファイル（tools/tune_checkbox.py dump で作り直せる）
bench/seigo_features.json

# エディタ
.vscode/
.idea/
.DS_Store

# 検証用スクリーンショット（記入済み様式が写るため公開しない）
docs/screenshots/
